# MongoDB Atlas connection string and database name
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=nirdesh

# JWT signing secret (generate a real random value before deploying)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Anthropic API key — used by the AI Orchestration layer (answer grading, tagging)
ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# MOD-12 Razorpay Payment Gateway Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
